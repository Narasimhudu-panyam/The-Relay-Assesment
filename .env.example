# Groq API Configuration (Enter your key locally in .env — NEVER commit .env)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20.0

# Observed Provider Dashboard Limits (for openai/gpt-oss-120b)
PROVIDER_RPM=30
PROVIDER_TPM=8000
PROVIDER_RPD=1000
PROVIDER_TPD=200000

# Application-Enforced Limits
RATE_LIMIT_RPM=25
RATE_LIMIT_TPM=7000
RATE_LIMIT_RPD=900
RATE_LIMIT_TPD=180000
MAX_CONCURRENT_REQUESTS=3
MAX_QUEUE_DEPTH=20
QUEUE_TIMEOUT_SECONDS=10.0
REQUEST_DEADLINE_SECONDS=30.0
MAX_RETRIES=2
RETRY_BUDGET_RATIO=0.25
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_SECONDS=15.0

# Pipeline Retrieval Defaults
RETRIEVAL_CHUNK_SIZE=400
RETRIEVAL_CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
USE_RERANKER=false
MIN_SIMILARITY_THRESHOLD=0.22

# Stand-in Server Configuration
STANDIN_HOST=127.0.0.1
STANDIN_PORT=8001
STANDIN_BASE_URL=http://127.0.0.1:8001

# Results & Paths
RESULTS_CSV_PATH=results/results.csv
PAPERS_DIR=papers
